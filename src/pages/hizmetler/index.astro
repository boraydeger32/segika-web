---
import { url } from '../../lib/url';
import Master from '../../layouts/Master.astro';
import Container from '../../components/Container.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import { software, matrix, guide } from '../../data/service-catalog';
import { services } from '../../data/services';
import { cta, contact } from '../../data/site';

/**
 * Services — yarışma teslimi, 2/3.
 *
 * Home'dan farkı: Home ürünü tanıtır, bu sayfa hizmetleri *karşılaştırılabilir*
 * kılar. Ziyaretçi buraya "hangisi bana lazım" sorusuyla gelir, o yüzden
 * omurga bir katalog + yetenek matrisi + seçim rehberi.
 *
 * Düzen bilinçli olarak Home'dan ayrı: koyu hero yok (Home'un işareti o),
 * bunun yerine açık ve sakin bir giriş; ağırlık matris tablosunda.
 */
---

<Master
  title="Hizmetler — SGK Otomasyon Modülleri ve Danışmanlık | Segika"
  description="Segika'nın altı yazılım modülü ve üç danışmanlık hizmeti. Hangi modülün hangi işi devraldığını karşılaştırın, işletmenize uygun olanı seçin."
>
  {/* 1 · Giriş — açık, sayı odaklı */}
  <section class="border-b border-rule">
    <Container class="framed py-16 lg:py-24">
      <div class="stagger max-w-[46rem]">
        <Eyebrow>Hizmetler</Eyebrow>
        <h1 class="mt-5 text-h1">
          Dokuz hizmet. Hepsi SGK yükünü sizden alıyor.
        </h1>
        <p class="mt-6 max-w-[58ch] text-lead text-ink-muted">
          Altı yazılım modülü ve üç danışmanlık hizmeti. Modüller ayrı ayrı ya da
          birlikte kullanılabilir; aşağıdaki matris hangisinin hangi işi
          devraldığını gösteriyor.
        </p>
        <div class="mt-9 flex flex-wrap items-center gap-x-5 gap-y-4">
          <a
            href="#matris"
            class="inline-flex items-center gap-2 rounded-md bg-accent px-6 py-3.5 font-medium text-canvas transition-colors hover:bg-accent-hover"
          >
            Karşılaştırma matrisi
            <svg class="h-3.5 w-3.5" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path
                d="M7 3v8m0 0L3.5 7.5M7 11l3.5-3.5"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </a>
          <a
            href={cta.primary.href}
            rel="noopener"
            class="text-small font-medium text-accent underline decoration-from-font underline-offset-4"
          >
            Ücretsiz deneyin
          </a>
        </div>
      </div>
    </Container>
  </section>

  {/* 2 · Yazılım modülleri — katalog girdisi gibi, numaralı ve kapsamlı */}
  <section aria-labelledby="yazilim-baslik">
    <Container class="framed py-(--spacing-section)">
      <div class="rise flex flex-wrap items-end justify-between gap-6">
        <div>
          <Eyebrow>Yazılım</Eyebrow>
          <h2 id="yazilim-baslik" class="mt-4 max-w-[20ch] text-h2">
            Altı modül, ayrı ayrı ya da birlikte.
          </h2>
        </div>
        <p class="font-mono text-chip uppercase text-ink-muted">01 — 06</p>
      </div>

      <div class="stagger mt-12 divide-y divide-hairline border-y border-hairline">
        {
          software.map((item, i) => (
            <article class="grid gap-x-10 gap-y-5 py-9 lg:grid-cols-[4rem_minmax(0,24rem)_minmax(0,1fr)]">
              <p class="font-mono text-chip tabular-nums text-ink-muted lg:pt-1.5">
                {String(i + 1).padStart(2, '0')}
              </p>

              <div>
                <h3 class="text-h3 font-medium">{item.name}</h3>
                <p class="mt-2.5 text-small text-ink-muted">{item.summary}</p>
                <p class="mt-4 rounded-md bg-accent-wash px-3 py-2 text-small text-ink">
                  <span class="font-mono text-chip uppercase text-ink-muted">Kime uygun</span>
                  <span class="mt-1 block">{item.fit}</span>
                </p>
                <a
                  href={url(item.href)}
                  class="group mt-4 inline-flex items-center gap-1.5 text-small font-medium text-accent"
                >
                  Modül sayfası
                  <svg
                    class="h-3.5 w-3.5 transition-transform duration-200 group-hover:translate-x-0.5"
                    viewBox="0 0 14 14"
                    fill="none"
                    aria-hidden="true"
                  >
                    <path
                      d="M3 7h8m0 0L7.5 3.5M11 7l-3.5 3.5"
                      stroke="currentColor"
                      stroke-width="1.4"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </a>
              </div>

              <div>
                <p class="font-mono text-chip uppercase text-ink-muted">Devraldığı işler</p>
                <ul class="mt-3 grid gap-x-8 gap-y-2 sm:grid-cols-2">
                  {item.scope.map((s) => (
                    <li class="flex gap-2.5 text-small text-ink-muted">
                      <svg
                        class="mt-[0.35em] h-3 w-3 shrink-0 text-electric"
                        viewBox="0 0 12 12"
                        fill="none"
                        aria-hidden="true"
                      >
                        <path
                          d="m2 6.2 2.6 2.6L10 3.4"
                          stroke="currentColor"
                          stroke-width="1.6"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                      {s}
                    </li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </Container>
  </section>

  {/* 3 · Yetenek matrisi — bu sayfanın omurgası, Home'da karşılığı yok */}
  <section id="matris" class="border-t border-rule bg-sunk-soft" aria-labelledby="matris-baslik">
    <Container class="framed py-(--spacing-section)">
      <div class="rise max-w-[46rem]">
        <Eyebrow>Karşılaştırma</Eyebrow>
        <h2 id="matris-baslik" class="mt-4 text-h2">Hangi modül hangi işi yapıyor?</h2>
        <p class="mt-4 max-w-[56ch] text-ink-muted">
          Soldaki sütunda sizi uğraştıran işi bulun, satırı takip edin.
          Çoğu işletme iki ya da üç modülle başlıyor.
        </p>
      </div>

      <div class="rise mt-12 overflow-x-auto rounded-lg border border-hairline bg-surface">
        <table class="w-full min-w-[42rem] border-collapse text-small">
          <caption class="sr-only">
            Segika modüllerinin devraldığı işler karşılaştırma tablosu
          </caption>
          <thead>
            <tr class="border-b border-hairline">
              <th scope="col" class="px-5 py-4 text-left font-mono text-chip font-normal uppercase text-ink-muted">
                İş
              </th>
              {
                matrix.columns.map((c) => (
                  <th
                    scope="col"
                    class="px-3 py-4 text-center font-mono text-chip font-normal uppercase text-ink"
                  >
                    {c}
                  </th>
                ))
              }
            </tr>
          </thead>
          <tbody>
            {
              matrix.rows.map((row) => (
                <tr class="border-b border-hairline/60 last:border-0 hover:bg-wash">
                  <th scope="row" class="px-5 py-3.5 text-left font-normal">
                    {row.job}
                  </th>
                  {matrix.columns.map((c) => {
                    const on = (row.has as readonly string[]).includes(c);
                    return (
                      <td class="px-3 py-3.5 text-center">
                        {on ? (
                          <>
                            <span
                              class="mx-auto flex h-5 w-5 items-center justify-center rounded-full bg-electric"
                              aria-hidden="true"
                            >
                              <svg class="h-3 w-3 text-ink" viewBox="0 0 12 12" fill="none">
                                <path
                                  d="m2 6.2 2.6 2.6L10 3.4"
                                  stroke="currentColor"
                                  stroke-width="1.8"
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                />
                              </svg>
                            </span>
                            <span class="sr-only">var</span>
                          </>
                        ) : (
                          <>
                            <span class="mx-auto block h-px w-3 bg-hairline" aria-hidden="true" />
                            <span class="sr-only">yok</span>
                          </>
                        )}
                      </td>
                    );
                  })}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <dl class="rise mt-6 flex flex-wrap gap-x-7 gap-y-2">
        {
          software.map((s) => (
            <div class="flex items-baseline gap-2">
              <dt class="font-mono text-chip uppercase text-ink">{s.code}</dt>
              <dd class="text-small text-ink-muted">{s.name}</dd>
            </div>
          ))
        }
      </dl>
    </Container>
  </section>

  {/* 4 · Seçim rehberi — profil bazlı */}
  <section aria-labelledby="rehber-baslik">
    <Container class="framed py-(--spacing-section)">
      <div class="rise max-w-[44rem]">
        <Eyebrow>Seçim rehberi</Eyebrow>
        <h2 id="rehber-baslik" class="mt-4 text-h2">Kendinize en yakın profili bulun.</h2>
      </div>

      <div class="stagger mt-12 grid gap-px overflow-hidden rounded-lg border border-hairline bg-hairline sm:grid-cols-2">
        {
          guide.map((g) => (
            <div class="bg-surface p-7">
              <h3 class="text-h3 font-medium">{g.profile}</h3>
              <p class="mt-2.5 text-small text-ink-muted">{g.need}</p>
              <ul class="mt-5 flex flex-wrap gap-2 border-t border-hairline pt-4">
                {g.picks.map((p) => (
                  <li class="rounded-full border border-hairline px-3 py-1 font-mono text-chip uppercase text-ink-muted">
                    {p}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </Container>
  </section>

  {/* 5 · Danışmanlık — yazılımın bitmediği yer */}
  <section class="border-t border-rule" aria-labelledby="dan-baslik">
    <Container class="framed py-(--spacing-section)">
      <div class="rise max-w-[44rem]">
        <Eyebrow>Danışmanlık</Eyebrow>
        <h2 id="dan-baslik" class="mt-4 text-h2">
          Yazılımın çözmediği yerde uzman desteği.
        </h2>
        <p class="mt-4 max-w-[56ch] text-ink-muted">
          Denetim, uyuşmazlık ve işe alım süreçleri yazılımla çözülmüyor.
          Bu üç alanda yanınızda oluyoruz.
        </p>
      </div>

      <div class="stagger mt-12 grid gap-px overflow-hidden rounded-lg border border-hairline bg-hairline lg:grid-cols-3">
        {
          services.map((s) => (
            <a href={url(s.href)} class="lift tick-corners group bg-surface p-7 transition-colors hover:bg-wash">
              <p class="font-mono text-chip tabular-nums text-ink-muted">{s.index}</p>
              <h3 class="mt-4 text-h3 font-medium group-hover:text-accent">{s.title}</h3>
              <p class="mt-3 text-small text-ink-muted">{s.summary}</p>
              <ul class="mt-6 space-y-1.5 border-t border-hairline pt-4">
                {s.highlights.slice(0, 4).map((h) => (
                  <li class="flex gap-2.5 text-small text-ink-muted">
                    <span class="mt-[0.62em] h-px w-2.5 shrink-0 bg-electric" aria-hidden="true" />
                    {h}
                  </li>
                ))}
              </ul>
            </a>
          ))
        }
      </div>
    </Container>
  </section>

  {/* 6 · Kapanış — koyu */}
  <section class="ruled-void border-t border-rule text-ink-inverse">
    <Container class="py-(--spacing-section)">
      <div class="stagger mx-auto max-w-[34rem] text-center">
        <h2 class="text-h2">Hangisi size uygun, birlikte belirleyelim.</h2>
        <p class="mt-5 text-ink-subtle">
          Sicil ve çalışan sayınızı iletin; ihtiyacınız olan modülleri ve fiyatı
          aynı gün paylaşalım.
        </p>
        <div class="mt-10 flex flex-wrap justify-center gap-4">
          <a
            href={cta.primary.href}
            rel="noopener"
            class="rounded-md bg-electric px-6 py-3.5 font-medium text-ink transition-colors hover:bg-electric-hover"
          >
            {cta.primary.label}
          </a>
          <a
            href={contact.whatsapp.href}
            rel="noopener"
            class="rounded-md border border-void-line px-6 py-3.5 font-medium text-ink-inverse transition-colors hover:border-ink-subtle"
          >
            WhatsApp’tan yazın
          </a>
        </div>
      </div>
    </Container>
  </section>
</Master>
