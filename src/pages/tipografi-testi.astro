---
/**
 * Geçici denetim sayfası — Faz 1.
 * IBM Plex'in Türkçe gliflerini ve tabular rakamlarını gözle doğrulamak için.
 * Site yayına alınmadan önce silinecek.
 */
import '../styles/global.css';

const turkce = 'ÇĞİÖŞÜ çğıöşü';
const ciftler = [
  ['İ', 'I', 'Noktalı büyük İ ile noktasız büyük I'],
  ['i', 'ı', 'Noktalı küçük i ile noktasız küçük ı'],
  ['Ş', 'S', 'Kuyruklu Ş ile düz S'],
  ['ş', 's', 'Kuyruklu ş ile düz s'],
  ['Ğ', 'G', 'Breve işaretli Ğ ile düz G'],
  ['ğ', 'g', 'Breve işaretli ğ ile düz g'],
  ['Ü', 'U', 'Umlautlu Ü ile düz U'],
  ['Ö', 'O', 'Umlautlu Ö ile düz O'],
  ['Ç', 'C', 'Çengelli Ç ile düz C'],
];

const zorKelimeler = [
  'İşlem Defteri',
  'Sağlık Raporu Onaylama',
  'Teşvik Hesaplama',
  'İşkur İşgücü Çizelgesi',
  'Yükümlülük',
  'Sığınmacı',
  'Çoğunluğu',
  'İŞVEREN YÜKÜMLÜLÜKLERİ',
  'SGK İŞ KAZASI TAKİBİ',
  'ÇALIŞAN · SİCİL · FİRMA',
];

// Hizalama testi: basamak sayıları farklı, sağa hizalı dizilmeli
const rakamlar = [
  ['ÇALIŞAN', '1.700.000+'],
  ['SİCİL', '61.000+'],
  ['FİRMA', '20.000+'],
  ['İŞ KAZASI', '4.000+'],
  ['TEŞVİK', '360.000.000+'],
];
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Tipografi testi — Segika</title>
  </head>
  <body>
    <main class="mx-auto max-w-[var(--container-page)] px-(--spacing-gutter) py-16">
      <p class="font-mono text-label uppercase text-ink-muted">Faz 1 · denetim sayfası</p>
      <h1 class="mt-3 text-display">IBM Plex · Türkçe glif denetimi</h1>
      <p class="mt-4 max-w-[var(--container-text)] text-ink-muted">
        Aşağıdaki her bölüm, fontun Türkçe'ye özgü harfleri doğru çizip çizmediğini
        ve rakamların sütun hâlinde hizalanıp hizalanmadığını gösterir.
      </p>

      <!-- 1 — Tüm Türkçe harfler, beş boyutta -->
      <section class="mt-16 border-t border-hairline pt-8">
        <h2 class="font-mono text-label uppercase text-ink-muted">
          01 — Türkçe harfler, beş boyutta
        </h2>
        <div class="mt-6 space-y-4 overflow-x-auto">
          <p class="text-[64px] leading-none tracking-[-0.028em]">{turkce}</p>
          <p class="text-[40px] leading-none tracking-[-0.022em]">{turkce}</p>
          <p class="text-[24px] leading-none">{turkce}</p>
          <p class="text-[17px] leading-none">{turkce}</p>
          <p class="text-[12px] leading-none">{turkce}</p>
          <p class="font-mono text-[24px] leading-none">{turkce}</p>
          <p class="font-mono text-[14px] leading-none">{turkce}</p>
        </div>
      </section>

      <!-- 2 — Karıştırılması kolay çiftler -->
      <section class="mt-16 border-t border-hairline pt-8">
        <h2 class="font-mono text-label uppercase text-ink-muted">
          02 — Ayırt edilmesi gereken çiftler
        </h2>
        <p class="mt-2 text-small text-ink-muted">
          İki glif birbirinden açıkça ayrılmalı. Özellikle İ/I ve i/ı kritik.
        </p>
        <ul class="mt-6 divide-y divide-hairline border-y border-hairline">
          {
            ciftler.map(([a, b, aciklama]) => (
              <li class="flex flex-wrap items-baseline gap-x-6 gap-y-2 py-4">
                <span class="w-24 shrink-0 text-[40px] leading-none tracking-tight sm:w-32">
                  {a}&thinsp;{b}
                </span>
                <span class="w-20 shrink-0 font-mono text-[28px] leading-none sm:w-28">
                  {a}&thinsp;{b}
                </span>
                <span class="min-w-0 flex-1 basis-full text-small text-ink-muted sm:basis-auto">
                  {aciklama}
                </span>
              </li>
            ))
          }
        </ul>
      </section>

      <!-- 3 — Gerçek site metinleri -->
      <section class="mt-16 border-t border-hairline pt-8">
        <h2 class="font-mono text-label uppercase text-ink-muted">
          03 — Sitede geçecek gerçek ifadeler
        </h2>
        <ul class="mt-6 space-y-3">
          {zorKelimeler.map((k) => <li class="text-h2">{k}</li>)}
        </ul>
      </section>

      <!-- 4 — Tabular rakam hizalaması -->
      <section class="mt-16 border-t border-hairline pt-8">
        <h2 class="font-mono text-label uppercase text-ink-muted">
          04 — Tabular rakamlar · sağa hizalı sütun
        </h2>
        <p class="mt-2 text-small text-ink-muted">
          Basamak sayısı farklı olsa da tüm rakamların sağ kenarı ve basamak
          genişlikleri aynı hizada olmalı. Defter bölümünün çalışması buna bağlı.
        </p>
        <dl class="mt-6 divide-y divide-hairline border-y border-hairline">
          {
            rakamlar.map(([etiket, deger]) => (
              <div class="flex items-baseline justify-between gap-8 py-5">
                <dt class="font-mono text-label uppercase text-ink-muted">{etiket}</dt>
                <dd class="text-figure font-medium">{deger}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <!-- 5 — Koyu panel: defter bölümünün rengi -->
      <section class="mt-16 border-t border-hairline pt-8">
        <h2 class="font-mono text-label uppercase text-ink-muted">
          05 — Koyu panel · defter bölümünün kontrastı
        </h2>
        <div class="on-ink mt-6 rounded-lg bg-ink p-8 sm:p-12">
          <p class="font-mono text-label uppercase text-ink-subtle">Aylık işlem hacmi</p>
          <dl class="mt-8 divide-y divide-hairline-inverse border-y border-hairline-inverse">
            {
              rakamlar.map(([etiket, deger]) => (
                <div class="flex items-baseline justify-between gap-8 py-5">
                  <dt class="font-mono text-label uppercase text-ink-subtle">{etiket}</dt>
                  <dd class="text-figure font-medium text-brand">{deger}</dd>
                </div>
              ))
            }
          </dl>
          <p class="mt-8 text-ink-inverse">
            Koyu zeminde ana metin — ÇĞİÖŞÜ çğıöşü
          </p>
          <p class="mt-2 text-small text-ink-subtle">
            Koyu zeminde ikincil metin — ÇĞİÖŞÜ çğıöşü
          </p>
        </div>
      </section>

      <!-- 6 — Renk token'ları ve ölçülen kontrast -->
      <section class="mt-16 border-t border-hairline pt-8">
        <h2 class="font-mono text-label uppercase text-ink-muted">06 — Renk token'ları</h2>
        <div class="mt-6 grid grid-cols-2 gap-px bg-hairline sm:grid-cols-3">
          {
            [
              ['canvas', '#FAF9F5', 'zemin'],
              ['surface', '#FFFFFF', 'kart'],
              ['wash', '#F2F0EA', 'sessiz dolgu'],
              ['ink', '#1C1B18', '16,2:1'],
              ['ink-muted', '#6B6862', '5,21:1'],
              ['hairline', '#E6E3DC', 'çizgi'],
              ['brand', '#2CBC63', 'grafik · koyuda 6,96:1'],
              ['accent', '#0C6E37', '6,36:1'],
              ['accent-wash', '#ECF6F0', 'vurgu zemini'],
            ].map(([ad, hex, not]) => (
              <div class="bg-canvas p-4">
                <div
                  class="h-14 w-full rounded-sm border border-hairline"
                  style={`background:${hex}`}
                />
                <p class="mt-3 font-mono text-[11px] uppercase tracking-wider">{ad}</p>
                <p class="font-mono text-[11px] text-ink-muted">{hex}</p>
                <p class="mt-1 text-[11px] text-ink-muted">{not}</p>
              </div>
            ))
          }
        </div>
      </section>

      <!-- 7 — Odak görünürlüğü -->
      <section class="mt-16 border-t border-hairline pt-8">
        <h2 class="font-mono text-label uppercase text-ink-muted">
          07 — Klavye odağı · Tab ile gezin
        </h2>
        <div class="mt-6 flex flex-wrap items-center gap-4">
          <a
            href="#"
            class="rounded-md bg-accent px-5 py-3 font-medium text-canvas transition-colors hover:bg-accent-hover"
          >
            Ücretsiz Deneyin
          </a>
          <a href="#" class="font-medium text-accent underline underline-offset-4">
            Üye Girişi
          </a>
          <button type="button" class="rounded-md border border-hairline bg-surface px-5 py-3">
            İncele
          </button>
        </div>
      </section>
    </main>
  </body>
</html>
