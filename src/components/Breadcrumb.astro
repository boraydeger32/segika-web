---
import { url } from '../lib/url';

interface Props {
  items: { label: string; href?: string }[];
}

const { items } = Astro.props;
---

<nav aria-label="Ekmek kırıntısı">
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-[11px] uppercase tracking-[0.1em] text-ink-muted">
    <li>
      <a href={url('/')} class="transition-colors hover:text-accent">Ana sayfa</a>
    </li>
    {
      items.map((item, i) => (
        <>
          <li aria-hidden="true" class="text-hairline">
            /
          </li>
          <li>
            {/* aria-current yalnızca son öğede; ara öğeler bağlantısızsa düz metin kalır */}
            {i === items.length - 1 ? (
              <span aria-current="page" class="text-ink">
                {item.label}
              </span>
            ) : item.href ? (
              <a href={url(item.href)} class="transition-colors hover:text-accent">
                {item.label}
              </a>
            ) : (
              <span>{item.label}</span>
            )}
          </li>
        </>
      ))
    }
  </ol>
</nav>
