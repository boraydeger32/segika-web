---
import { url } from '../lib/url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Motion from '../components/v2/Motion.astro';
import { site } from '../data/site';

/**
 * Master page — Home, Landing ve Services sayfalarının ortak iskeleti.
 *
 * Header, Footer, font yüklemesi, meta etiketler ve hareket sürücüsü burada;
 * sayfalar yalnızca kendi içeriklerini yazar. Üç sayfanın ortak tasarım dili
 * taşımasının teknik garantisi bu dosya.
 *
 * `headerTone`: sayfa koyu bir bölümle başlıyorsa header da koyu açılır ve
 * o bloğun görsel devamı olur; kaydırılınca her iki durumda da aynı açık
 * kapsüle döner.
 */
interface Props {
  title: string;
  description: string;
  /** Sayfanın kendi yolu dışında bir canonical gerekiyorsa. */
  canonicalPath?: string;
  headerTone?: 'light' | 'dark';
  /** Gövdeye eklenecek sınıf — zemin dokusunu sayfa belirler. */
  bodyClass?: string;
  /** Arama motorlarından gizlenecek sayfalar (geçici/kopya içerik). */
  noindex?: boolean;
}

const {
  title,
  description,
  canonicalPath,
  headerTone = 'light',
  bodyClass = 'ruled',
  noindex = false,
} = Astro.props;

const canonical = new URL(canonicalPath ?? Astro.url.pathname, site.url).href;
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('/brand/favicon-64.png')} type="image/png" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link
      rel="preload"
      href={url('/fonts/ibm-plex-sans-latin-wght-normal.woff2')}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={url('/fonts/ibm-plex-sans-latin-ext-wght-normal.woff2')}
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:site_name" content={site.tagline} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
  </head>

  <body class={bodyClass}>
    <a
      href="#icerik"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:rounded-md focus:bg-electric focus:px-4 focus:py-2.5 focus:text-ink"
    >
      İçeriğe geç
    </a>

    <slot name="pretop" />

    {/* Header DOM'da bağımsız: sticky öğe kapsayıcısının dışına çıkamadığı
        için koyu bloğa gömülemez — hero bitince kaybolurdu. */}
    <Header tone={headerTone} />

    <main id="icerik">
      <slot />
    </main>

    <Footer />
    <Motion />
  </body>
</html>
